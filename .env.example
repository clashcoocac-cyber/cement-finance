# Copy to .env (never commit it).
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=vosem.uz,www.vosem.uz,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://vosem.uz,https://www.vosem.uz
# true behind TLS (default when DEBUG is off); false only for plain-HTTP LAN use
HTTPS=true

# Telegram bot (optional, only when run_bot.py is used)
BOT_TOKEN=
LOG_LEVEL=INFO

# bot (only when run_bot.py is used)
DB_NAME=db.sqlite3
DB_PATH=../db.sqlite3
